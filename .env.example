# Copy to .env and fill real secrets. NEVER commit .env
# See backend/src/* for usages.

# ---- Database: 2 option, 1টা active রাখো ----
# Local (docker-compose: postgres db=pos, user=pos, pass=pos123)
DATABASE_URL="postgresql://pos:pos123@localhost:5432/pos?schema=public"
# Cloud (Neon) example:
# DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- Auth / Security (REQUIRED in production, 32+ random bytes hex) ----
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-generate-32-byte-hex
JWT_REFRESH_SECRET=change-me-generate-32-byte-hex-different

# ---- SMS provider credentials encryption (AES-256-GCM) ----
SMS_CREDENTIALS_KEY=change-me-generate-32-byte-hex-different-again

# ---- CORS / Frontend origin (comma-separated allowlist) — ONE source of truth ----
# ALLOWED_FRONTEND_ORIGINS is derived from WEB_ORIGIN in src/config/env.ts
WEB_ORIGIN=http://localhost:3020,https://shohojhisab.com,https://mobile.shohojhisab.com

# ---- Shared cookie domain (REQUIRED in production across subdomains) ----
# API = https://server.shohojhisab.com, frontend = https://shohojhisab.com (+mobile).
# Without this, browser JS cannot read the CSRF cookie (host-only) and every
# POST/PATCH/DELETE fails with 403 "CSRF token mismatch".
# Production server .env must have: COOKIE_DOMAIN=shohojhisab.com
# Leave empty for localhost.
# COOKIE_DOMAIN=shohojhisab.com

# ---- Redis ----
REDIS_URL=
REDIS_REQUIRED=0

# ---- Platform billing issuer ----
PLATFORM_ISSUER_NAME="POS Platform"
PLATFORM_ISSUER_EMAIL=

# ---- Platform bootstrap (one-time, no-login super-admin) ----
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Set to 0 to disable POST /api/v1/platform/bootstrap after first admin exists.
ALLOW_PLATFORM_BOOTSTRAP=1
PLATFORM_BOOTSTRAP_TOKEN=change-me-generate-32-byte-hex-bootstrap

# ---- SMS flags ----
SMS_DEV_MODE=1
SMS_REQUIRE_CREDS=0
# SMS_FORCE_FAIL=0

# ---- CI/CD ----
# These are set in the GitHub Actions workflow, override locally if needed
# PLATFORM_BOOTSTRAP_TOKEN is set by CI for one-time bootstrap
# JWT_SECRET and JWT_REFRESH_SECRET are set by CI secrets
# NODE_ENV=test is set by CI for running tests

# ─────────────────────────────────────────────────────────────────
# DigitalOcean Deployment (set these as GitHub Secrets, NOT in .env)
# Run: gh secret set DO_HOST  --body="your-do-ip"
# ─────────────────────────────────────────────────────────────────
# DO_HOST=                   # DigitalOcean droplet IP or hostname
# DO_HOST_STAGING=           # Staging droplet IP or hostname
# DO_PORT=22                 # SSH port (default: 22)
# DO_USER=root               # SSH user for the droplet
# DO_SSH_KEY=                # SSH private key for the droplet
# BACKEND_URL=http://localhost:4000    # Public backend URL
# BACKEND_URL_STAGING=http://staging:4000
# FRONTEND_URL=http://localhost:3020   # Public frontend URL
# FRONTEND_URL_STAGING=http://staging:3020
# WEB_ORIGIN=http://localhost:3020,https://shohojhisab.com,https://mobile.shohojhisab.com
# PORT=4000                  # Server port
# DATABASE_URL=postgresql://pos:pos123@localhost:5432/pos?schema=public
