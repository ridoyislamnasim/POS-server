# Copy to .env and fill real secrets. NEVER commit .env
# See backend/src/* for usages.

# ---- Database: 2 option, 1টা active রাখো ----
# Local (docker-compose: postgres db=pos, user=pos, pass=pos123)
DATABASE_URL="postgresql://pos:pos123@localhost:5432/pos?schema=public"
# Cloud (Neon) example:
# DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- Auth / Security (REQUIRED in production, 32+ random bytes hex) ----
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-generate-32-byte-hex
JWT_REFRESH_SECRET=change-me-generate-32-byte-hex-different

# ---- SMS provider credentials encryption (AES-256-GCM) ----
SMS_CREDENTIALS_KEY=change-me-generate-32-byte-hex-different-again

# ---- CORS / Frontend origin (comma-separated allowlist) — ONE source of truth ----
# ALLOWED_FRONTEND_ORIGINS is derived from WEB_ORIGIN in src/config/env.ts
WEB_ORIGIN=http://localhost:3020,https://shohojhisab.com,https://mobile.shohojhisab.com

# ---- Redis ----
REDIS_URL=
REDIS_REQUIRED=0

# ---- Platform billing issuer ----
PLATFORM_ISSUER_NAME="POS Platform"
PLATFORM_ISSUER_EMAIL=

# ---- Platform bootstrap (one-time, no-login super-admin) ----
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Set to 0 to disable POST /api/v1/platform/bootstrap after first admin exists.
ALLOW_PLATFORM_BOOTSTRAP=1
PLATFORM_BOOTSTRAP_TOKEN=change-me-generate-32-byte-hex-bootstrap

# ---- SMS flags ----
SMS_DEV_MODE=1
SMS_REQUIRE_CREDS=0
# SMS_FORCE_FAIL=0
