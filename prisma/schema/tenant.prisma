// Tenant + legal business profile. One tenant = one SaaS customer (e.g. Nokshi).

model Tenant {
  id                  String             @id @default(cuid())
  name                String
  industryPack        String             @default("FASHION")
  industryPackVersion String             @default("1.0.0")
  country             String             @default("BD")
  timezone            String             @default("Asia/Dhaka")
  locale              String             @default("en")
  dataRegion          String             @default("AP_SOUTH")
  planId              String?
  subscriptionStatus  SubscriptionStatus @default(TRIAL)
  trialStart          DateTime?
  trialEnd            DateTime?
  catalogVersion      Int                @default(1)
  apiAccessEnabled         Boolean   @default(true)
  apiAccessDisabledAt      DateTime?
  apiAccessDisabledReason  String?
  smsAccessEnabled         Boolean   @default(true)
  smsAccessDisabledAt      DateTime?
  smsAccessDisabledReason  String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @default(now()) @updatedAt

  plan       Plan?           @relation(fields: [planId], references: [id])
  businesses Business[]
  locations  Location[]
  branches   Branch[]
  users      UserTenant[]
  products      Product[]
  categories    Category[]
  brands        Brand[]
  units         Unit[]
  sales         Sale[]
  customers     Customer[]
  suppliers     Supplier[]
  settings      TenantSettings?
  platformInvoices PlatformInvoice[]
  smsSettings   SmsSettings?
  limitOverrides    TenantLimitOverride[]
  featureOverrides  TenantFeatureOverride[]
  accessRequests    TenantAccessRequest[]
}

model Currency {
  code       String  @id
  name       String
  minorUnits Int     @default(2)
  active     Boolean @default(true)
}

model Plan {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  description  String?
  interval     PlanInterval @default(MONTHLY)
  price        Decimal      @default(0) @db.Decimal(19, 4)
  yearlyPrice  Decimal?     @db.Decimal(19, 4)
  currency     String       @default("BDT")
  active       Boolean      @default(true)
  displayOrder Int          @default(0)
  tenants      Tenant[]
  planLimits   PlanLimit[]
  planFeatures PlanFeature[]
  createdAt    DateTime     @default(now())
}

model PlanLimit {
  id         String      @id @default(cuid())
  planId     String
  plan       Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  resource   ResourceKey
  limitValue Int?
  unlimited  Boolean     @default(false)
  disabled   Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([planId, resource])
  @@index([planId])
}

model PlanFeature {
  id        String    @id @default(cuid())
  planId    String
  plan      Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature   FeatureKey
  enabled   Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([planId, feature])
  @@index([planId])
}

// Immutable override grants — each approval creates a new row.
// "current" flag points to the active override for quick lookup.
// Historical rows are kept for audit trail.
model TenantLimitOverride {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resource    ResourceKey
  limitValue  Int
  approvedBy  String
  approvedAt  DateTime       @default(now())
  expiresAt   DateTime?
  status      OverrideStatus @default(ACTIVE)
  current     Boolean        @default(true)
  reason      String?
  requestId   String?        // Link back to TenantAccessRequest
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([tenantId, resource, current])
  @@index([tenantId, status])
  @@index([status])
}

model TenantFeatureOverride {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feature     FeatureKey
  enabled     Boolean        @default(true)
  approvedBy  String
  approvedAt  DateTime       @default(now())
  expiresAt   DateTime?
  status      OverrideStatus @default(ACTIVE)
  current     Boolean        @default(true)
  reason      String?
  requestId   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([tenantId, feature, current])
  @@index([tenantId, status])
  @@index([status])
}

model TenantAccessRequest {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedBy     String
  type            RequestType
  resource        ResourceKey?
  feature         FeatureKey?
  requestedPlanId String?       // For PLAN_CHANGE: target plan ID
  currentValue    Int?
  requestedValue  Int?
  reason          String
  status          RequestStatus @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  expiresAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([tenantId, status])
  @@index([status, createdAt])
}

model Business {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  legalName String?
  vatId     String?
  address   String?
  phone     String?
  email     String?
  logoUrl   String?
  currency  String   @default("BDT")
  createdAt DateTime @default(now())
}
