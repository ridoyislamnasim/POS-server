// Stock is the physical balance on a Location.
// Channel is sale origin (Sale.channel), never a second inventory database.
// StockMovement is append-only. Do not update or delete movements.

model Stock {
  id                String         @id @default(cuid())
  tenantId          String
  locationId        String
  location          Location       @relation(fields: [locationId], references: [id])
  variantId         String
  variant           ProductVariant @relation(fields: [variantId], references: [id])
  channel           ChannelType    @default(STORE)
  quantity          Decimal        @db.Decimal(19, 4)
  reservedQuantity  Decimal        @default(0) @db.Decimal(19, 4)

  @@unique([tenantId, locationId, channel, variantId])
}

model StockMovement {
  id            String            @id @default(cuid())
  tenantId      String
  locationId    String
  variantId     String
  type          StockMovementType
  quantity      Decimal           @db.Decimal(19, 4)
  saleId        String?
  reason        String?
  notes         String?
  createdById   String?
  referenceType String?
  referenceId   String?
  createdAt     DateTime          @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, createdAt, id])
}

model StockTake {
  id          String          @id @default(cuid())
  tenantId    String
  branchId    String
  branch      Branch          @relation(fields: [branchId], references: [id])
  locationId  String
  status      StockTakeStatus @default(DRAFT)
  notes       String?
  createdById String
  postedById  String?
  createdAt   DateTime        @default(now())
  postedAt    DateTime?
  lines       StockTakeLine[]

  @@index([tenantId, locationId, createdAt])
}

model StockTakeLine {
  id          String    @id @default(cuid())
  stockTakeId String
  stockTake   StockTake @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  variantId   String
  systemQty   Decimal   @db.Decimal(19, 4)
  countedQty  Decimal   @db.Decimal(19, 4)
  variance    Decimal   @db.Decimal(19, 4)
}
